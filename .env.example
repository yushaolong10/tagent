# Copy this file to .env and fill in your values.
# The agent refuses to start until ANTHROPIC_API_KEY and MODEL_ID are set.

# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-xxxx

# Optional: point at a proxy/gateway (e.g. an LLM gateway). Leave empty for
# the Anthropic API directly.
ANTHROPIC_BASE_URL=

# Required: the primary model, e.g. claude-sonnet-4-5 or
# claude-3-5-sonnet-20241022
MODEL_ID=claude-sonnet-4-5

# Optional: fallback model used when the primary is overloaded (HTTP 529).
FALLBACK_MODEL_ID=